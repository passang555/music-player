<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Playing Music</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #0f172a;
      color: #ffffff;
      font-family: system-ui, sans-serif;
      text-align: center;
    }
    .tap-area {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .btn {
      padding: 16px 32px;
      font-size: 1.2rem;
      background: #2563eb;
      border-radius: 50px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body onclick="startAudio()">

  <div class="tap-area">
    <div id="status" class="btn">Tap Anywhere to Listen 🎵</div>
  </div>

  <!-- Replace the URL inside src with your direct MP3 link -->
  <audio id="audio" src="https://files.catbox.moe/uc7ar8.mp3" preload="auto"></audio>

  <script>
    const audio = document.getElementById('audio');
    const status = document.getElementById('status');

    // Attempt autoplay immediately
    window.addEventListener('DOMContentLoaded', () => {
      audio.play().then(() => {
        status.innerText = "Playing Audio...";
      }).catch(() => {
        // Fallback: waiting for user's screen tap
      });
    });

    function startAudio() {
      audio.play();
      status.innerText = "Playing Audio...";
    }
  </script>
</body>
</html>
